# Allow init to mount /efs and access the EFS partition block device
allow init efs_block_device:blk_file rw_file_perms;
allow init efs_file:dir mounton;

# Allow init to create /mnt/sdcard and storage symlinks on tmpfs
allow init tmpfs:lnk_file create_file_perms;

# Allow init to stat /proc/filesystems
allow init proc_filesystems:file getattr;

# Allow init to load kernel modules (v4l2-mem2mem.ko, coda.ko) in on post-fs
allow init self:capability sys_module;
allow init { vendor_file system_file }:system module_load;

# Allow init on-boot tuning/permissions for cpufreq, devfreq, and IIO sensors
allow init sysfs_devices_system_cpu:file rw_file_perms;
allow init sysfs_devfreq:file { rw_file_perms setattr };
allow init sysfs_sensors:file setattr;
