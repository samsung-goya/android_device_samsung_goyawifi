# Android fstab file for Marvell PXA988 / Samsung goyawifi (Linux 4.19)
#
# Verified partition table on mmcblk0 (SanDisk SEM08G):
#   p4  = EFS    (20 MiB)
#   p9  = RECOVERY (16 MiB)
#   p10 = KERNEL (16 MiB)
#   p14 = CACHE  (344 MiB)
#   p15 = SYSTEM (1485 MiB)
#   p16 = USER   (5130 MiB)

#<src>                                                          <mnt_point>  <type>  <mnt_flags and options>                                  <fs_mgr_flags>
/dev/block/mmcblk0p15                                           /system      ext4    ro,barrier=1                                             wait
/dev/block/mmcblk0p14                                           /cache       ext4    noatime,nosuid,nodev,barrier=1,data=ordered              wait,check
/dev/block/mmcblk0p16                                           /data        f2fs    noatime,nosuid,nodev,discard,inline_xattr,inline_data,reserve_root=32768,resgid=1065,whint_mode=user-based  wait,check,encryptable=footer,length=-16384
/dev/block/mmcblk0p4                                            /efs         ext4    ro,nosuid,nodev,noload,barrier=1                         wait
/dev/block/mmcblk0p10                                           /boot        emmc    defaults                                                 defaults
/dev/block/mmcblk0p9                                            /recovery    emmc    defaults                                                 defaults
/devices/platform/soc/d4200000.axi/d4280000.sdh/mmc_host/mmc1*  auto         auto    defaults                                                 voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/soc/d4200000.axi/d4208000.usb*                auto         auto    defaults                                                 voldmanaged=usbdisk:auto
/dev/block/zram0                                                none         swap    defaults                                                 zramsize=536870912,max_comp_streams=2
