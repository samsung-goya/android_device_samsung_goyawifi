# SPDX-License-Identifier: GPL-3.0-or-later
#
# Board-specific init rules for Samsung Galaxy Tab 3 Lite 7.0 (SM-T110 / goyawifi)

on early-init
    # Legacy by-name block symlinks for compatibility with TWRP & recovery tools
    mkdir /dev/block/platform/sdhci-pxav3.2 0755 root root
    mkdir /dev/block/platform/sdhci-pxav3.2/by-name 0755 root root
    symlink /dev/block/mmcblk0p4 /dev/block/platform/sdhci-pxav3.2/by-name/EFS
    symlink /dev/block/mmcblk0p8 /dev/block/platform/sdhci-pxav3.2/by-name/PARAM
    symlink /dev/block/mmcblk0p9 /dev/block/platform/sdhci-pxav3.2/by-name/RECOVERY
    symlink /dev/block/mmcblk0p10 /dev/block/platform/sdhci-pxav3.2/by-name/KERNEL
    symlink /dev/block/mmcblk0p14 /dev/block/platform/sdhci-pxav3.2/by-name/CACHE
    symlink /dev/block/mmcblk0p15 /dev/block/platform/sdhci-pxav3.2/by-name/SYSTEM
    symlink /dev/block/mmcblk0p16 /dev/block/platform/sdhci-pxav3.2/by-name/USER

on boot
    # Start wpa_supplicant without a pre-bound -i wlan0 so ISupplicant@1.1
    # addInterface() creates and registers wlan0 cleanly on demand.
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot
